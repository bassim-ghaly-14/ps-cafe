{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PS Cafe",
  "version": "0.1.0",
  "identifier": "com.pscafe.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:prod"
  },
  "app": {
    "windows": [{ "title": "PS Cafe", "width": 1100, "height": 750, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": { "sql": { "preload": ["sqlite:ps-cafe.db"] } }
}

